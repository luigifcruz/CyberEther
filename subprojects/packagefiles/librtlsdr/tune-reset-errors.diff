Propagate RTL-SDR endpoint reset and R82xx PLL lock failures.

diff --git a/src/librtlsdr.c b/src/librtlsdr.c
--- a/src/librtlsdr.c
+++ b/src/librtlsdr.c
@@ -1704,8 +1704,10 @@
 	if (!dev)
 		return -1;
 
-	rtlsdr_write_reg(dev, USBB, USB_EPA_CTL, 0x1002, 2);
-	rtlsdr_write_reg(dev, USBB, USB_EPA_CTL, 0x0000, 2);
+	if (rtlsdr_write_reg(dev, USBB, USB_EPA_CTL, 0x1002, 2) < 0)
+		return -1;
+	if (rtlsdr_write_reg(dev, USBB, USB_EPA_CTL, 0x0000, 2) < 0)
+		return -1;
 
 	return 0;
 }
