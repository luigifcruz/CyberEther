+EM_JS(EM_VAL, usbi_em_device_call, (usbi_transfer* transfer, EM_VAL device, EM_VAL method, EM_VAL args, unsigned timeout), {
+	device = Emval.toValue(device);
+	method = Emval.toValue(method);
+	args = Emval.toValue(args);
+	const state = device[Symbol.for('libusb.transfers')] ||=
+		{pending: new Set(), barrier: null, failure: null};
+	let resolve, reject;
+	const promise = new Promise((accept, fail) => { resolve = accept; reject = fail; });
+	let drained;
+	const cancellations = Module.libusbTransferCancellations ||=
+		new Map();
+	const record = {
+		done: false, submitted: false, timer: null,
+		drained: new Promise(resolve => { drained = resolve; }),
+		retire() {
+			record.submitted = false;
+			state.pending.delete(record);
+			drained();
+		},
+		finish(value, error) {
+			if (record.done) return;
+			record.done = true;
+			clearTimeout(record.timer);
+			if (transfer) cancellations.delete(transfer);
+			if (error) reject(error);
+			else resolve(value);
+		},
+	};
+	const drain = () => {
+		if (!record.submitted || state.barrier) return;
+		const interrupted = [...state.pending];
+		let timer;
+		const timeout = new Promise(resolve => { timer = setTimeout(() => resolve(true), 1000); });
+		state.barrier = Promise.race([
+			Promise.all(interrupted.map(pending => pending.drained)).then(() => false),
+			timeout,
+		]).then(async expired => {
+			clearTimeout(timer);
+			if (!expired || interrupted.every(pending => !pending.submitted)) return;
+			const chain = Symbol.for('libusb.open_close_chain');
+			const previous = device[chain] || Promise.resolve(0);
+			const recovery = previous.then(async refCount => {
+				const configuration = device.configuration;
+				const interfaces = configuration ? configuration.interfaces
+					.filter(iface => iface.claimed)
+					.map(iface => [iface.interfaceNumber, iface.alternate.alternateSetting]) : [];
+				if (refCount) await device.close();
+				const error = new DOMException('USB transfer interrupted by recovery', 'AbortError');
+				for (const pending of interrupted) {
+					pending.retire();
+					pending.finish(undefined, error);
+				}
+				if (refCount) {
+					await device.open();
+					if (configuration && device.configuration?.configurationValue !== configuration.configurationValue) {
+						await device.selectConfiguration(configuration.configurationValue);
+					}
+					for (const [iface, alternate] of interfaces) {
+						await device.claimInterface(iface);
+						await device.selectAlternateInterface(iface, alternate);
+					}
+				}
+				return refCount;
+			});
+			device[chain] = recovery.catch(() => previous);
+			await recovery;
+		}).catch(error => {
+			state.failure = error;
+			for (const pending of interrupted) pending.finish(undefined, error);
+			throw error;
+		}).finally(() => {
+			clearTimeout(timer);
+			state.barrier = null;
+		});
+		state.barrier.catch(() => {});
+	};
+	if (transfer) cancellations.set(transfer, () => {
+		drain();
+		record.finish(undefined);
+	});
+	const complete = (value, error) => {
+		record.retire();
+		record.finish(value, error);
+	};
+	const start = () => {
+		if (record.done) return;
+		if (state.barrier) {
+			state.barrier.then(start, error => record.finish(undefined, error));
+			return;
+		}
+		try {
+			if (state.failure) throw state.failure;
+			record.submitted = true;
+			state.pending.add(record);
+			if (timeout) record.timer = setTimeout(() => {
+				drain();
+				record.finish(undefined, new DOMException('USB transfer timed out', 'TimeoutError'));
+			}, timeout);
+			Promise.resolve(device[method](...args)).then(value => complete(value), error => complete(undefined, error));
+		} catch (error) {
+			complete(undefined, error);
+		}
+	};
+	start();
+	return Emval.toHandle(promise);
+});
