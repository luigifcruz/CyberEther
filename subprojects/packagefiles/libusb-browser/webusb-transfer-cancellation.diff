+EM_JS(EM_VAL, usbi_em_make_cancellable_promise, (usbi_transfer* transfer, EM_VAL handle), {
+	const promise = Emval.toValue(handle);
+	let cancel;
+	const cancellation = new Promise(resolve => cancel = resolve);
+	const cancellations = Module.libusbTransferCancellations ||=
+		new Map();
+	cancellations.set(transfer, cancel);
