+#ifdef _WIN32
+// Winsock shutdown does not reliably wake WSAPoll. Bound each wait so
+// ClientImpl::stop() also interrupts a blocked write, preserving the full
+// write timeout when the request has not been cancelled.
+inline ssize_t select_write(socket_t sock, time_t sec, time_t usec,
+                            const std::atomic<bool> *cancelled) {
+  if (!cancelled) { return select_write(sock, sec, usec); }
+
+  auto timeout = sec < 0 ? -1 : static_cast<int>(sec * 1000 + usec / 1000);
+  const auto deadline = std::chrono::steady_clock::now() +
+                        std::chrono::milliseconds(timeout);
+  while (!cancelled->load()) {
+    auto interval = timeout < 0 ? 20 : (std::min)(timeout, 20);
+    auto ret = select_impl(sock, POLLOUT, 0, interval * 1000);
+    if (ret != 0 || timeout == 0) { return ret; }
+    if (timeout > 0) {
+      const auto remaining = deadline - std::chrono::steady_clock::now();
+      if (remaining <= std::chrono::steady_clock::duration::zero()) { return 0; }
+      timeout = static_cast<int>(
+          std::chrono::duration_cast<std::chrono::milliseconds>(remaining).count());
+    }
+  }
+  return -1;
+}
+#endif
+
