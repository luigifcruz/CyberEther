 const uint8_t sevenLsbBitmask = 0b01111111;
 const uint8_t msbBitmask = 0b10000000;
 
+static size_t leb128Size(size_t value) {
+	size_t size = 1;
+	while (value >= 128) {
+		value >>= 7;
+		++size;
+	}
+	return size;
+}
+
+static void appendLeb128(binary &data, size_t value) {
+	while (value >= 128) {
+		data.push_back(byte((value & sevenLsbBitmask) | msbBitmask));
+		value >>= 7;
+	}
+	data.push_back(byte(value));
+}
+
+static bool isSequenceHeader(const binary &obu) {
+	return ((obu.front() & obuFrameTypeMask) >> obuFrameTypeBitshift) ==
+	       obuFrameTypeSequenceHeader;
+}
+
+static bool isDiscardableObu(const binary &obu) {
+	const auto type = (obu.front() & obuFrameTypeMask) >> obuFrameTypeBitshift;
+	return type == byte(2) || type == byte(8) || type == byte(15);
+}
+
+static optional<byte> obuLayer(const binary &obu) {
+	if ((obu.front() & obuHasExtensionMask) != byte(0))
+		return obu[1] & byte(0b11111000);
+	return std::nullopt;
+}
