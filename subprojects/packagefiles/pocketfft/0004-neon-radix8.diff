+// The arithmetic below is PocketFFT's radix-8 butterfly, with vector lanes
+// supplied by load/store adapters for adjacent i values or terminal k groups.
+template<bool fwd, typename Load, typename Store>
+__attribute__((always_inline)) inline void neon_butterfly8(
+  const Load &load, const Store &store)
+  {
+  using C = cmplx<float32x4_t>;
+  constexpr float hsqt2 = 0.707106781186547524400844362104849f;
+  C a0, a1, a2, a3, a4, a5, a6, a7;
+  PM(a1,a5,load(1),load(5));
+  PM(a3,a7,load(3),load(7));
+  ROTX90<fwd>(a7);
+  PMINPLACE(a1,a3);
+  ROTX90<fwd>(a3);
+  PMINPLACE(a5,a7);
+  auto tmp = a5.r;
+  a5.r = hsqt2*(fwd ? a5.r+a5.i : a5.r-a5.i);
+  a5.i = hsqt2*(fwd ? a5.i-tmp : a5.i+tmp);
+  tmp = a7.r;
+  a7.r = hsqt2*(fwd ? a7.i-a7.r : -a7.r-a7.i);
+  a7.i = hsqt2*(fwd ? -tmp-a7.i : tmp-a7.i);
+  PM(a0,a4,load(0),load(4));
+  PM(a2,a6,load(2),load(6));
+  PMINPLACE(a0,a2);
+  store(0,a0+a1); store(4,a0-a1);
+  store(2,a2+a3); store(6,a2-a3);
+  ROTX90<fwd>(a6);
+  PMINPLACE(a4,a6);
+  store(1,a4+a5); store(5,a4-a5);
+  store(3,a6+a7); store(7,a6-a7);
+  }
+
+// These lanes belong to one transform; batch SIMD still uses the generic path.
+template<bool fwd> size_t neon_pass8(size_t ido, size_t l1, size_t k,
+  const cmplx<float> *POCKETFFT_RESTRICT cc,
+  cmplx<float> *POCKETFFT_RESTRICT ch,
+  const cmplx<float> *POCKETFFT_RESTRICT wa)
+  {
+  size_t i=1;
+  for (; i+4<=ido; i+=4)
+    {
+    auto load = [&](size_t j) { return neon_load(cc+i+ido*(j+8*k)); };
+    auto store = [&](size_t j, const cmplx<float32x4_t> &v)
+      {
+      auto value = j==0 ? v
+        : v.template special_mul<fwd>(neon_load(wa+i-1+(j-1)*(ido-1)));
+      neon_store(ch+i+ido*(k+l1*j), value);
+      };
+    neon_butterfly8<fwd>(load, store);
+    }
+  return i;
+  }
+
+template<bool fwd> size_t neon_pass8_terminal(size_t l1,
+  const cmplx<float> *POCKETFFT_RESTRICT cc,
+  cmplx<float> *POCKETFFT_RESTRICT ch)
+  {
+  size_t k=0;
+  for (; k+4<=l1; k+=4)
+    {
+    auto load = [&](size_t j)
+      {
+      const auto p = cc+j+8*k;
+      auto a = vcombine_f32(vld1_f32(reinterpret_cast<const float *>(p)),
+        vld1_f32(reinterpret_cast<const float *>(p+8)));
+      auto b = vcombine_f32(vld1_f32(reinterpret_cast<const float *>(p+16)),
+        vld1_f32(reinterpret_cast<const float *>(p+24)));
+      return cmplx<float32x4_t>(vuzp1q_f32(a,b), vuzp2q_f32(a,b));
+      };
+    auto store = [&](size_t j, const cmplx<float32x4_t> &v)
+      { neon_store(ch+k+l1*j, v); };
+    neon_butterfly8<fwd>(load, store);
+    }
+  return k;
+  }
+
